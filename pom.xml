<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>skillexchange</groupId>
    <artifactId>skill-exchange</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <name>Peer Tutoring and Skill Exchange Booking System</name>
    <description>JavaFX client, Java socket server and a JDBC database</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.13</javafx.version>
        <sqlite.version>3.54.1.0</sqlite.version>
        <junit.version>5.14.4</junit.version>
        <!-- Which program "mvn exec:java" starts. Override with -Dexec.mainClass=... -->
        <exec.mainClass>skillexchange.server.ServerMain</exec.mainClass>
    </properties>

    <dependencies>
        <!-- The desktop user interface (course units 12 and 13). -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- The JDBC driver for SQLite, a database kept in one file (course unit 11). -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- Unit tests. Only on the test class path, never shipped with the application. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all,-serial,-processing</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Runs the JUnit tests during "mvn test" and "mvn package". -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
            </plugin>

            <!-- "mvn javafx:run" starts the desktop application. -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>skillexchange.ui.App</mainClass>
                </configuration>
            </plugin>

            <!-- "mvn exec:java" starts the server (or any other main class, see exec.mainClass above). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
            </plugin>

            <!--
              "mvn package" also builds target/skill-exchange.jar: one file holding the application and
              every library it needs. Start it with "java -jar skill-exchange.jar" (desktop application)
              or "java -jar skill-exchange.jar server" (server only).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>skill-exchange</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <!-- Writes "Main-Class: skillexchange.Launcher" into the JAR's manifest. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>skillexchange.Launcher</mainClass>
                                </transformer>
                                <!-- Keeps the entry that lets DriverManager find the SQLite JDBC driver. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          JavaFX has a different native library for each operating system, and Maven normally fetches
          only the one for the computer it runs on. "mvn package -Pall-platforms" adds the others, so
          the same skill-exchange.jar runs on Windows, Linux and Macs with Apple silicon.
          Intel Macs are left out on purpose: their library files have the same names as the Apple
          silicon ones, and a JAR can hold only one file of each name. On an Intel Mac, run from source.
        -->
        <profile>
            <id>all-platforms</id>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>linux</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>mac-aarch64</classifier>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
